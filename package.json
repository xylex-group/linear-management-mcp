{
  "name": "linear-management-mcp",
  "version": "0.1.0",
  "description": "Autonomous product-management MCP engine for Linear and GitHub governance",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "linear-management-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js"
  },
  "keywords": [
    "linear",
    "mcp",
    "typescript",
    "templates",
    "product-management",
    "github"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "dependencies": {
    "@linear/sdk": "^86.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@octokit/auth-app": "^8.2.0",
    "@octokit/rest": "^22.0.1",
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.31",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3"
  }
}
