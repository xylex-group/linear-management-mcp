# Required
LINEAR_API_KEY=lin_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional defaults
LINEAR_DEFAULT_TEAM_ID=
LINEAR_DEFAULT_TEMPLATE=engineering-task
TEMPLATE_STRICT_MODE=true

# Optional JSON object to add/override templates.
# Shape:
# {
#   "security-review": {
#     "displayName": "Security Review",
#     "description": "Template for security-focused work",
#     "titlePrefix": "[Security]",
#     "requiredSections": ["Context", "Risk", "Mitigation", "Validation"],
#     "optionalSections": ["Notes"]
#   }
# }
LINEAR_TEMPLATE_OVERRIDES_JSON=

# Optional GitHub App configuration.
# Set all values below to enable GitHub tools in this MCP server.
GITHUB_APP_ID=2995603
GITHUB_APP_OWNER=your-org-or-user
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_API_BASE_URL=
GITHUB_DEFAULT_TEMPLATE=issue-feature
GITHUB_TEMPLATE_STRICT_MODE=true

# Optional JSON object to add/override GitHub body templates.
# Shape:
# {
#   "issue-security": {
#     "displayName": "Issue Security",
#     "description": "Template for security-related GitHub issues",
#     "requiredSections": ["Summary", "Risk", "Mitigation", "Validation"],
#     "optionalSections": ["References"]
#   }
# }
GITHUB_TEMPLATE_OVERRIDES_JSON=
